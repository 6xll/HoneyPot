{
  "uid": "cowrie-honeypot-uid",
  "title": "Cowrie Honeypot Dashboard",
  "tags": ["cowrie", "honeypot", "security"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "type": "stat",
      "title": "Total Connections",
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs-native-uid"},
      "targets": [
        {
          "expr": "job:cowrie eventid:cowrie.session.connect | stats count() as total",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "blue"}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "type": "stat",
      "title": "Failed Logins",
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs-native-uid"},
      "targets": [
        {
          "expr": "job:cowrie eventid:cowrie.login.failed | stats count() as total",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "type": "stat",
      "title": "Successful Logins",
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs-native-uid"},
      "targets": [
        {
          "expr": "job:cowrie eventid:cowrie.login.success | stats count() as total",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "type": "stat",
      "title": "Commands Executed",
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs-native-uid"},
      "targets": [
        {
          "expr": "job:cowrie eventid:cowrie.command.input | stats count() as total",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "orange"}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "type": "table",
      "title": "Top Failed Login Attempts",
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs-native-uid"},
      "targets": [
        {
          "expr": "job:cowrie eventid:cowrie.login.failed | stats by (username, password, src_ip) count() as attempts | sort by (attempts) desc | limit 15",
          "refId": "A"
        }
      ],
      "options": {"showHeader": true},
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "attempts"},
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "type": "table",
      "title": "Successful Logins (Breaches!)",
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs-native-uid"},
      "targets": [
        {
          "expr": "job:cowrie eventid:cowrie.login.success | stats by (username, password, src_ip) count() as logins | sort by (logins) desc | limit 15",
          "refId": "A"
        }
      ],
      "options": {"showHeader": true},
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "logins"},
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "type": "table",
      "title": "Top Attackers (by IP)",
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs-native-uid"},
      "targets": [
        {
          "expr": "job:cowrie eventid:cowrie.session.connect | stats by (src_ip) count() as connections | sort by (connections) desc | limit 10",
          "refId": "A"
        }
      ],
      "options": {"showHeader": true}
    },
    {
      "id": 8,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "type": "table",
      "title": "Commands Executed",
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs-native-uid"},
      "targets": [
        {
          "expr": "job:cowrie eventid:cowrie.command.input | stats by (input, src_ip) count() as times | sort by (times) desc | limit 15",
          "refId": "A"
        }
      ],
      "options": {"showHeader": true}
    },
    {
      "id": 9,
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 20},
      "type": "logs",
      "title": "Live Honeypot Events",
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs-native-uid"},
      "targets": [
        {
          "expr": "job:cowrie",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
